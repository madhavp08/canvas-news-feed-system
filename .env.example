# Lines are loaded at startup. For GEMINI_*, SENDGRID_*, NOTIFY_EMAILS, CANVAS_COURSE_URL,
# BROWSER, POLL_INTERVAL, SKIP_REACT_EMAIL_HTML — values here OVERRIDE the shell environment.
# Other vars only fill in if unset in the shell.

# SendGrid API key — get one at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# The "from" address for notification emails.
# Must be a verified sender in your SendGrid account.
SENDGRID_FROM_EMAIL=you@example.com

# Comma-separated list of email addresses to notify.
NOTIFY_EMAILS=friend1@example.com,friend2@example.com

# Optional—Google Gemini API key. When set, notification emails begin with a TL;DR summary.
# https://ai.google.dev/gemini-api/docs/api-key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional—short promotional line appended to notification emails (plain + HTML).
# Bare http:// or https:// URLs are turned into links; no other HTML markup is interpreted.
# Do not wrap values in " or '; main.py does not strip quotes (they appear in the email).
# EMAIL_PROMO_TEXT=Try out this tool to study for finals: https://www.thinkex.app/home

# Optional—Gemini model ID (defaults to fastest Flash Lite tier below).
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional—set to 1 to skip React Email and use legacy HTML (SendGrid unchanged).
# SKIP_REACT_EMAIL_HTML=

# Canvas course URL (used by the polling loop).
CANVAS_COURSE_URL=https://umd.instructure.com/courses/1398395

# Browser to read cookies from.
BROWSER=comet

# How often to check for updates (in seconds). Default: 3600 (1 hour).
POLL_INTERVAL=3600
